{
  "name": "zihad-bepari/goloadtest",
  "description": "High-performance API load and stress testing engine with Laravel Artisan CLI integration and web studio",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Zihad Bepari",
      "email": "2215151139@uits.edu.bd"
    }
  ],
  "require": {
    "php": ">=7.4|^8.0|^8.1|^8.2|^8.3"
  },
  "autoload": {
    "psr-4": {
      "GoLoadTest\\": "adapters/php-laravel/src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "GoLoadTest\\GoLoadTestServiceProvider"
      ]
    }
  }
}
